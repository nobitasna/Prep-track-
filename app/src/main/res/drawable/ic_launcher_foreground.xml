<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stylized Modern 'P' with Upward Growth Arrow (Prep Track Branding) -->
    <!-- Safe zone: 21 to 87 -->

    <!-- Upward Arrow integrated into Left Stem -->
    <path
        android:pathData="M38,76 L38,50 L48,50 L48,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="76"
                android:endX="48"
                android:endY="32"
                android:type="linear">
                <item android:offset="0.0" android:color="#0A84FF" />
                <item android:offset="1.0" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrowhead on Stem -->
    <path
        android:pathData="M33,52 L43,34 L53,52 L45,52 L45,54 L41,54 L41,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="52"
                android:endX="53"
                android:endY="34"
                android:type="linear">
                <item android:offset="0.0" android:color="#0A84FF" />
                <item android:offset="1.0" android:color="#60A5FA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Loop of 'P' curving to the right -->
    <path
        android:pathData="M43,32 L60,32 C68.8,32 76,39.2 76,48 C76,56.8 68.8,64 60,64 L48,64 L48,54 L60,54 C63.3,54 66,51.3 66,48 C66,44.7 63.3,42 60,42 L43,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="32"
                android:endX="76"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.5" android:color="#0A84FF" />
                <item android:offset="1.0" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward secondary motion arrow head at loop apex -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M70,36 L78,28 L82,38 L77,35 L74,42 L68,40 L71,33 Z" />

</vector>
